<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/services.log</file>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.pantavanij.sourcingreq.services.config.MaskingPatternLayout">
<!--                <maskPattern>\"address\"\s*:\s*\"(.*?)\"</maskPattern> &lt;!&ndash; Address JSON pattern &ndash;&gt;-->
                <patternsProperty>(phone=)|(mobile=)|(address=)</patternsProperty>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} trace-id=%X{traceId} %-5level ${hostName} %c{1}:%L - %m%n</pattern>
            </layout>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/services-%d{yyyy-MM-dd}-%i.log</fileNamePattern>
            <maxFileSize>1MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.pantavanij.sourcingreq.services.config.MaskingPatternLayout">
<!--                <maskPattern>\"address\"\s*:\s*\"(.*?)\"</maskPattern> &lt;!&ndash; Address JSON pattern &ndash;&gt;-->
                <patternsProperty>(phone=)|(mobile=)|(address=)|(mobilePhone=)|(fullName=)|(email=)</patternsProperty>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} trace-id=%X{traceId} %-5level ${hostName} %c{1}:%L - %m%n</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="RollingFile"/>
        <appender-ref ref="Console"/>
    </root>
</configuration>